COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=


AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Baked into the client bundle at build time by docker-compose.yaml.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Where the DB replica lives inside S3_BUCKET.
LITESTREAM_S3_PREFIX=yimby/database.sqlite

# Dev replica prefix.
LITESTREAM_DEV_S3_PREFIX=yimby-dev/database.sqlite

# How often WAL frames ship to S3 instead of shipping it all on every write lol 
LITESTREAM_SYNC_INTERVAL=5m

# Domain for automatic HTTPS. Leave unset/blank to serve plain HTTP on :80.
SITE_ADDRESS=yimby-tracker.fyi

# GoatCounter dashboard. Needs its own DNS A record pointing at this instance.
STATS_ADDRESS=stats.yimby-tracker.fyi

# Footer contact form. Token from @BotFather; chat id of the chat that should
# receive messages (message the bot once, then read it from getUpdates).
# Leave either blank to disable the form.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- yimby-scraper (only needed to run `docker compose run --rm scraper`) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=yimby-scraper/1.0
OPENAI_API_KEY=
