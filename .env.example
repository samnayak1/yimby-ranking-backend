COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=


AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Baked into the client bundle at build time by docker-compose.yaml.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Where the DB replica lives inside S3_BUCKET.
LITESTREAM_S3_PREFIX=yimby/database.sqlite

# Dev replica prefix. MUST differ from LITESTREAM_S3_PREFIX.
LITESTREAM_DEV_S3_PREFIX=yimby-dev/database.sqlite

# How often WAL frames ship to S3 = your worst-case data loss window.
LITESTREAM_SYNC_INTERVAL=5m

# Domain for automatic HTTPS. Leave unset/blank to serve plain HTTP on :80.
SITE_ADDRESS=yimby-tracker.fyi
